<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>5119dd60-a608-4a84-8c11-e4fa6dc873e0</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenAI" Version="2.14.0" />
  </ItemGroup>

  <!-- Single source of truth for prompt and schema: ../vision, tuned with identify.py. -->
  <ItemGroup>
    <Content Include="../vision/prompt.md;../vision/schema.json" Link="vision/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
