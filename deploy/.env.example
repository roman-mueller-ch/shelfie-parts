# Copy to .env (git-ignored) next to docker-compose.yml.

# Tailscale auth key for the "parts" sidecar.
# Admin console → Settings → Keys: not reusable, pre-approved.
# Only used on first start; afterwards the node state in ./data is used.
TS_AUTHKEY_PARTS=tskey-auth-...

# Generate with: openssl rand -hex 32
PARTDB_APP_SECRET=

# Base currency for prices in Part-DB. Cannot be changed later.
PARTDB_BASE_CURRENCY=CHF

# --- Capture API
# Tailscale auth key for the "capture" sidecar (not reusable, pre-approved).
TS_AUTHKEY_CAPTURE=tskey-auth-...
# terraform -chdir=infra output openai_base_url / -raw openai_api_key
CAPTURE_VISION_BASE_URL=https://oai-shelfie-xxxxxx.openai.azure.com/openai/v1/
CAPTURE_VISION_API_KEY=
# Part-DB → User settings → API tokens (edit level). The admin user first needs
# System → Users → Permissions → API: "Access API" and "Manage API tokens" = Allow.
CAPTURE_PARTDB_TOKEN=
