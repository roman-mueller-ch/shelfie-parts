# Copy to .env (git-ignored) next to docker-compose.yml.

# Tailscale auth key for the "parts" sidecar.
# Admin console → Settings → Keys: not reusable, pre-approved.
# Only used on first start; afterwards the node state in ./data is used.
TS_AUTHKEY_PARTS=tskey-auth-...

# Generate with: openssl rand -hex 32
PARTDB_APP_SECRET=

# Base currency for prices in Part-DB. Cannot be changed later.
PARTDB_BASE_CURRENCY=CHF

# Part-DB image version; set by scripts/update.sh <version>. Empty: the default in docker-compose.yml.
# PARTDB_VERSION=2.20.5

# --- Backups (scripts/backup.sh, nightly by cron and before every scripts/update.sh)
# rsync target over Tailscale; the VM's SSH key must be allowed there. Empty: local copies only.
SHELFIE_BACKUP_TARGET=

# --- Capture API
# Tailscale auth key for the "capture" sidecar (not reusable, pre-approved).
TS_AUTHKEY_CAPTURE=tskey-auth-...
# terraform -chdir=infra output openai_base_url / -raw openai_api_key
CAPTURE_VISION_BASE_URL=https://oai-shelfie-xxxxxx.openai.azure.com/openai/v1/
CAPTURE_VISION_API_KEY=
# Part-DB → User settings → API tokens (edit level). The admin user first needs
# System → Users → Permissions → API: "Access API" and "Manage API tokens" = Allow.
CAPTURE_PARTDB_TOKEN=

# --- Public access (Cloudflare Tunnel, docs/getting-started.md §8)
# Zero Trust → Networks → Tunnels → shelfie → the token from the install command.
CLOUDFLARE_TUNNEL_TOKEN=
# Second tunnel, for Part-DB at db.rmlabs.ch (Tunnels → shelfie-partdb).
CLOUDFLARE_TUNNEL_TOKEN_PARTDB=
# Starts both cloudflared containers with the stack. Remove to run tailnet-only.
COMPOSE_PROFILES=public
# Address for QR codes on labels and "open in Part-DB" links. Empty: the tailnet
# address (https://parts.<tailnet>.ts.net), which needs Tailscale to open.
PARTDB_PUBLIC_URL=https://db.rmlabs.ch
